# 示例：复制到 /etc/nginx/sites-available/ 后启用
# sudo ln -s /etc/nginx/sites-available/remove-watermark /etc/nginx/sites-enabled/
# sudo nginx -t && sudo systemctl reload nginx

server {
    listen 80;
    server_name your-domain.com;   # 改成你的域名

    root /var/www/remove-watermark;
    index index.html;

    # 静态资源可长期缓存（Vite 文件名带 hash）
    location /assets/ {
        expires 30d;
        add_header Cache-Control "public, immutable";
        try_files $uri =404;
    }

    location / {
        try_files $uri $uri/ /index.html;
    }

    # 可选：开启 HTTPS 后用 certbot 自动改写本段
    # listen 443 ssl;
    # ssl_certificate     /etc/letsencrypt/live/your-domain.com/fullchain.pem;
    # ssl_certificate_key /etc/letsencrypt/live/your-domain.com/privkey.pem;
}
